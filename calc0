chisla = [x for x in '0123456789']
operi = [x for x in "+-=*^%!@#$()/"]
operators = {
    "+": {"priority": 1, "chit": "left"},
    "-": {"priority": 1, "chit": "left"},
    "*": {"priority": 2, "chit": "left"},
    "/": {"priority": 2, "chit": "left"},
    "^": {"priority": 3, "chit": "right"},
    "(": {"priority": -1000, "chit": "right"}

}
def tokensize(stroka):
    tokeni = []
    p = 0

    while p < len(stroka):
        if stroka[p].isspace():
            p += 1
        elif stroka[p] in chisla or stroka[p] == '.':
            nachalo = p

            while p < len(stroka) and (
                stroka[p] in chisla or stroka[p] == '.'
            ):
                p += 1

            chislo = stroka[nachalo:p]
            float(chislo)
            tokeni.append(chislo)

        elif stroka[p] in operators or stroka[p] == ')':
            tokeni.append(stroka[p])
            p += 1
        else:
            raise ValueError

    def operand(p):
        if p >= len(tokeni):
            raise ValueError

        if tokeni[p] == '-':
            chast, p = operand(p + 1)
            return ['(', '-1', '*'] + chast + [')'], p

        if tokeni[p] == '(':
            chast, p = virazhenie(p + 1)

            if p >= len(tokeni) or tokeni[p] != ')':
                raise ValueError

            return ['('] + chast + [')'], p + 1

        float(tokeni[p])
        return [tokeni[p]], p + 1

    def virazhenie(p):
        rezultat, p = operand(p)

        while p < len(tokeni) and tokeni[p] != ')':
            znak = tokeni[p]

            if znak not in operators or znak == '(':
                raise ValueError

            chast, p = operand(p + 1)
            rezultat.append(znak)
            rezultat.extend(chast)

        return rezultat, p

    rezultat, p = virazhenie(0)

    if p != len(tokeni):
        raise ValueError

    return rezultat

ch = []
oper = []

def proverka_skobki(a):
    chetchik = 0
    for i in a:
        if i == '(':
            chetchik += 1
        elif i == ')':
            chetchik -= 1

        if chetchik  < 0:
            return None

    if chetchik == 0:
        return a
    else:
        return None


def evaluate(token):
    ch.clear()
    oper.clear()
    try:
        t = tokensize(token)
        tok = proverka_skobki(t)
        if tok is None:
            return None
        zhdem_chislo = True
        for i in t:
            if i not in operi:
                if not zhdem_chislo:
                    return None
                ch.append(float(i))
                zhdem_chislo = False
            elif i == "(":
                if not zhdem_chislo:
                    return None
                push_opertor(i)
            elif i == ")":
                if zhdem_chislo:
                    return None
                push_opertor(i)
            else:
                if zhdem_chislo or i not in operators:
                    return None
                push_opertor(i)
                zhdem_chislo = True
        if zhdem_chislo:
            return None
        while len(oper) > 0:
            if len(ch) < 2:
                return None
            reduce_top()
        if len(ch) != 1:
            return None
        return float(ch[0])
    except (ZeroDivisionError, ValueError, IndexError):
        return None
    
def push_opertor(opn):
    if opn == "(":
        oper.append(opn)
    elif opn == ")":
        while oper[-1] != "(":
            reduce_top()
        oper.remove(oper[-1])
    elif len(oper) == 0:
        oper.append(opn)
    elif operators[opn]["priority"] > operators[oper[-1]]["priority"] and operators[opn]["chit"] == "left":
        oper.append(opn)
    elif operators[opn]["priority"] <= operators[oper[-1]]["priority"] and operators[opn]["chit"] == "left":
        while len(oper) > 0 and operators[opn]["priority"] <= operators[oper[-1]]["priority"]:
            reduce_top()
        oper.append(opn)
    elif operators[opn]["priority"] >= operators[oper[-1]]["priority"] and operators[opn]["chit"] == "right":
        oper.append(opn)
    elif operators[opn]["priority"] < operators[oper[-1]]["priority"] and operators[opn]["chit"] == "right":
        while len(oper) > 0 and operators[opn]["priority"] < operators[oper[-1]]["priority"]:
            reduce_top()
        oper.append(opn)


def reduce_top():
    r = apply(oper[-1], ch[-1], ch[-2])
    ch.pop()
    ch.pop()
    ch.append(r)
    oper.pop()

def apply(z, a ,b):
    if z == "+":
        return a + b

    elif z == "-":
        return b - a

    elif z == "*":
        return a * b

    elif z == "/":
        return b / a

    elif z == "%":
        return b % a

    elif z == "^":
        return b ** a

if __name__ == "__main__":
    strochka = input()
    print(evaluate(strochka))
