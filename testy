from calc0 import evaluate as e

t = [
    ("1 / 0", None),
    ("10 / (5 - 5)", None),
    ("-5 + 2", -3),
    ("2 * -3", -6),
    ("10 - -5", 15),
    ("-(3 + 4)", -7),
    ("-(-5)", 5),
    ("1.5 + 2.5", 4.0),
    ("7 / 2", 3.5),
    ("0.5 * 4", 2.0),
    ("((2 + 3)) * 2", 10),
    ("2 * ((1 + 2) * (3 - 1))", 12),
    ("((((5))))", 5),
    ("(2 + 3", None),
    ("2 + 3)", None)
